filters:
  and:
    - file.hasProperty("ship")
formulas:
  ХП: note["ХП"]
  Экипаж: note["Экипаж"]
  Размер: note["Размер"]
  Модификации: note["Модификации"]
  Грузоподъемность: note["Грузоподъемность"]
  Скорость: note["Скорость"]
  Скорость поворота: note["Скорость поворота"]
  Маневреность: note["Манёвреность"]
  Броня: note["Броня"]
  Untitled: note["Стоимость"]
  Минимальная раб. сила для постройки: note["Минимальная раб. сила для постройки"]
  Субкласы: note["Субкласы"]
  Класс: link('/Goliaph/mechanics/Типы кораблей/'+file.name,file.name.split('.')[0])
properties:
  formula.Untitled:
    displayName: Стоимость
views:
  - type: table
    name: Table
    order:
      - formula.Класс
      - formula.ХП
      - formula.Экипаж
      - formula.Размер
      - formula.Модификации
      - formula.Грузоподъемность
      - formula.Скорость
      - formula.Скорость поворота
      - formula.Маневреность
      - formula.Броня
      - formula.Untitled
      - formula.Минимальная раб. сила для постройки
      - formula.Субкласы
    sort:
      - property: formula.Размер
        direction: ASC
      - property: formula.Untitled
        direction: DESC
      - property: file.name
        direction: ASC
      - property: formula.Грузоподъемность
        direction: DESC
