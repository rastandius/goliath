filters:
  and:
    - file.hasProperty("ship")
formulas:
  ХП: note["ХП"]
  Экипаж: note["Экипаж"]
  Размер: note["Размер"]
  Модификации: note["Модификации"]
  Грузоподъемность: note["Грузоподъемность"]
  Скорость: note["Скорость"]
  Скорость поворота: note["Скорость поворота"]
  Маневреность: note["Манёвреность"]
  Броня: note["Броня"]
  Untitled: note["Стоимость"]
  Минимальная раб. сила для постройки: note["Минимальная рабочая сила для постройки"]
  Субкласы: note["Субкласы"]
  Untitled 2: link(file,file.name)
properties:
  formula.Untitled:
    displayName: Стоимость
  formula.Минимальная раб. сила для постройки:
    displayName: Минимальная рабочая сила для постройки
  formula.Untitled 2:
    displayName: Тип корабля
views:
  - type: table
    name: Table
    order:
      - formula.Untitled 2
      - formula.ХП
      - formula.Экипаж
      - formula.Размер
      - formula.Модификации
      - formula.Грузоподъемность
      - formula.Скорость
      - formula.Скорость поворота
      - formula.Маневреность
      - formula.Броня
      - formula.Untitled
      - formula.Минимальная раб. сила для постройки
      - formula.Субкласы
    sort:
      - property: formula.Untitled 2
        direction: DESC
      - property: file.basename
        direction: DESC
      - property: formula.Минимальная раб. сила для постройки
        direction: ASC
      - property: formula.Размер
        direction: ASC
      - property: formula.Untitled
        direction: DESC
      - property: file.name
        direction: ASC
      - property: formula.Грузоподъемность
        direction: DESC
    columnSize:
      formula.Минимальная раб. сила для постройки: 70
