filters:
  and:
    - file.inFolder("Goliaph/mechanics/Снаряды")
    - '!file.name.contains("снаряд")'
    - '!file.name.contains("Бочка")'
    - '!file.name.contains("Скат")'
formulas:
  Тип: link('/Goliaph/mechanics/Снаряды/'+file.name,file.name.split('.')[0])
views:
  - type: table
    name: Table
    order:
      - formula.Тип
      - Урон по щитам
      - Урон по парусам
      - Урон по корпусу
      - Урон по команде
      - Стоимость
      - Дальность
      - Вес
      - Свойства
    sort:
      - property: file.name
        direction: ASC
