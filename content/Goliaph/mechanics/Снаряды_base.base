filters:
  and:
    - file.inFolder("Goliaph/mechanics/Снаряды")
    - '!file.name.contains("снаряд")'
    - '!file.name.contains("Бочка")'
    - '!file.name.contains("Скат")'
formulas:
  Тип снаряда: link(file,file.name)
views:
  - type: table
    name: Table
    order:
      - formula.Тип снаряда
      - Урон по щитам
      - Урон по парусам
      - Урон по корпусу
      - Урон по команде
      - Стоимость
      - Дальность
      - Вес
      - Свойства
    sort:
      - property: file.name
        direction: ASC
