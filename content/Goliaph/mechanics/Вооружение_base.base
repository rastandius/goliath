filters:
  and:
    - file.inFolder("Goliaph/mechanics/Вооружение")
formulas:
  Untitled: ""
  Стоимость: note["Стоимость"]
  Дальность: note["Дальность"]
  Угол: note["Угол"]
  Урон: note["Урон"]
  Нддв: note["Нддв"]
  Свойства: note["Свойства"].join("; ")
  Untitled 2: link(file,file.name)
properties:
  formula.Untitled 2:
    displayName: Название
views:
  - type: table
    name: Table
    order:
      - formula.Untitled 2
      - formula.Стоимость
      - formula.Дальность
      - formula.Угол
      - formula.Урон
      - formula.Нддв
      - formula.Свойства
    sort:
      - property: formula.Свойства
        direction: DESC
      - property: formula.Стоимость
        direction: ASC
      - property: formula.Untitled
        direction: ASC
