filters:
  and:
    - file.hasLink("Goliaph/mechanics/Вооружение.html")
formulas:
  Untitled: ""
  Стоимость: note["Стоимость"]
  Дальность: note["Дальность"]
  Угол: note["Угол"]
  Урон: note["Урон"]
  Нддв: note["Нддв"]
  Свойства: note["Свойства"].join("; ")
views:
  - type: table
    name: Table
    order:
      - file.name
      - formula.Стоимость
      - formula.Дальность
      - formula.Угол
      - formula.Урон
      - formula.Нддв
      - formula.Свойства
    sort:
      - property: formula.Свойства
        direction: DESC
      - property: formula.Стоимость
        direction: ASC
      - property: file.name
        direction: DESC
      - property: formula.Untitled
        direction: ASC
