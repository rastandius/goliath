filters:
  and:
    - file.inFolder("Goliaph/mechanics/Обшивка")
formulas:
  КД: note["КД"]
  Скорость: note["Скорость"]
  Скорость поворота: note["Скорость поворота"]
  Броня: note["Броня"]
  Стоимость: note["Стоимость"]
  Свойства: note["Особое свойство"]
  Тип обшивки: link(file,file.name)
views:
  - type: table
    name: Table
    order:
      - formula.Тип обшивки
      - formula.КД
      - formula.Скорость
      - formula.Скорость поворота
      - formula.Броня
      - formula.Стоимость
      - formula.Свойства
    sort:
      - property: formula.Тип обшивки
        direction: ASC
