filters:
  and:
    - file.inFolder("Goliaph/mechanics/Обшивка")
formulas:
  КД: note["КД"]
  Скорость: note["Скорость"]
  Скорость поворота: note["Скорость поворота"]
  Броня: note["Броня"]
  Стоимость: note["Стоимость"]
  Свойства: note["Особое свойство"]
views:
  - type: table
    name: Table
    order:
      - file.name
      - formula.КД
      - formula.Скорость
      - formula.Скорость поворота
      - formula.Броня
      - formula.Стоимость
      - formula.Свойства
    sort: []
